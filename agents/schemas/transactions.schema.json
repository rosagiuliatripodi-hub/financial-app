{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conti-chiari/transactions",
  "title": "Transazioni normalizzate",
  "description": "Output del parser deterministico. Nessun LLM interviene su questo artefatto.",
  "type": "object",
  "required": ["session_id", "source", "period", "currency", "transactions", "rejected"],
  "additionalProperties": false,
  "properties": {
    "session_id": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["filename", "rows_total", "rows_parsed", "rows_rejected", "dialect"],
      "additionalProperties": false,
      "properties": {
        "filename": { "type": "string" },
        "rows_total": { "type": "integer", "minimum": 0 },
        "rows_parsed": { "type": "integer", "minimum": 0 },
        "rows_rejected": { "type": "integer", "minimum": 0 },
        "dialect": {
          "type": "string",
          "description": "Dialetto CSV riconosciuto o confermato dall'utente",
          "enum": ["it-standard", "en-standard", "banca-generico", "user-mapped"]
        }
      }
    },
    "period": {
      "type": "object",
      "required": ["from", "to", "months"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "format": "date" },
        "to": { "type": "string", "format": "date" },
        "months": { "type": "number", "minimum": 0 }
      }
    },
    "currency": { "type": "string", "const": "EUR" },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "date", "description", "amount"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^t[0-9]{3,}$" },
          "date": { "type": "string", "format": "date" },
          "description": { "type": "string" },
          "amount": {
            "type": "number",
            "description": "Negativo per le uscite, positivo per le entrate"
          }
        }
      }
    },
    "rejected": {
      "type": "array",
      "description": "Righe scartate. La pipeline prosegue comunque e la UI dichiara il numero.",
      "items": {
        "type": "object",
        "required": ["row", "reason"],
        "additionalProperties": false,
        "properties": {
          "row": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
